{
  "name": "@kalshi-lab/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "check-types": "tsc --noEmit",
    "balance": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/index.ts balance",
    "markets": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/index.ts markets",
    "smoke-order": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/index.ts smoke-order",
    "test": "node --test src/*.test.ts",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@kalshi-lab/kalshi": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2"
  }
}
