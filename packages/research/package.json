{
  "name": "@kalshi-lab/research",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "check-types": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node --test src/*.test.ts src/simulation/*.test.ts",
    "microstructure": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/cli.ts",
    "simulate-maker": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/simulation/cli.ts",
    "trade-report": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/trade-report.ts"
  },
  "dependencies": {
    "@kalshi-lab/db": "workspace:*",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "@electric-sql/pglite": "0.5.8"
  }
}
