KALSHI_ENV=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Neon Postgres connection URL; set locally, never commit credentials.
DATABASE_URL=
# demo = authenticated demo REST + demo WebSocket.
# production_public = unsigned production REST polling, no API credentials used.
KALSHI_RECORDER_SOURCE=demo
KALSHI_RECORDER_MAX_MARKETS=25
# Optional comma-separated explicit open binary tickers, at most MAX_MARKETS.
KALSHI_TRACK_TICKERS=
MARKET_SNAPSHOT_INTERVAL_MS=5000
MARKET_DATA_STALE_MS=120000
