{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@kalshi-lab/db#build": {
      "outputs": []
    },
    "@kalshi-lab/kalshi#build": {
      "outputs": []
    },
    "@kalshi-lab/worker#build": {
      "outputs": []
    },
    "@kalshi-lab/cli#build": {
      "outputs": []
    },
    "@kalshi-lab/research#build": {
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "KALSHI_ENV",
    "KALSHI_API_KEY_ID",
    "KALSHI_PRIVATE_KEY_PATH",
    "KALSHI_RECORDER_SOURCE",
    "KALSHI_RECORDER_MAX_MARKETS",
    "KALSHI_TRACK_TICKERS",
    "MARKET_SNAPSHOT_INTERVAL_MS",
    "MARKET_DATA_STALE_MS"
  ]
}
