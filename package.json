{
  "name": "kalshi-lab",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "pnpm --filter @kalshi-lab/kalshi test",
    "kalshi:balance": "pnpm --filter @kalshi-lab/cli balance",
    "kalshi:markets": "pnpm --filter @kalshi-lab/cli markets",
    "kalshi:smoke-order": "pnpm --filter @kalshi-lab/cli smoke-order"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.4",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
