{
  "name": "kalshi-lab",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "kalshi:balance": "pnpm --filter @kalshi-lab/cli balance",
    "kalshi:markets": "pnpm --filter @kalshi-lab/cli markets",
    "kalshi:smoke-order": "pnpm --filter @kalshi-lab/cli smoke-order",
    "db:generate": "pnpm --filter @kalshi-lab/db generate",
    "db:migrate": "pnpm --filter @kalshi-lab/db migrate",
    "db:check": "pnpm --filter @kalshi-lab/db migration:check",
    "worker:record": "pnpm --filter @kalshi-lab/worker record",
    "worker:once": "pnpm --filter @kalshi-lab/worker once",
    "worker:trades": "pnpm --filter @kalshi-lab/worker trades",
    "research:microstructure": "pnpm --filter @kalshi-lab/research microstructure",
    "research:simulate-maker": "pnpm --filter @kalshi-lab/research simulate-maker",
    "research:trade-report": "pnpm --filter @kalshi-lab/research trade-report"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.4",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7"
  }
}
